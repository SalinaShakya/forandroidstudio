<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="170dp"
    android:layout_height="300dp"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp">

    <!-- Using RelativeLayout to allow the Add button to "stick" to the corner -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Product Image -->
<!--            <ImageView-->
<!--                android:id="@+id/imgProduct"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="140dp"-->
<!--                android:padding="20dp"-->
<!--                android:scaleType="fitCenter"-->
<!--                android:src="@drawable/ic_launcher_background" />-->
            <!-- Product Image Container -->
            <!-- Product Image Container -->
<!--            <FrameLayout-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="130dp"-->
<!--                android:layout_marginBottom="10dp"-->
<!--                android:background="@drawable/rectangle_product"-->
<!--                android:padding="18dp">-->

<!--                <ImageView-->
<!--                    android:id="@+id/imgProduct"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="match_parent"-->
<!--                    android:scaleType="fitCenter"-->
<!--                    android:src="@drawable/ic_launcher_background"/>-->

<!--            </FrameLayout>-->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/rectangle_product"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/imgProduct"
                   android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_launcher_background"/>

            </FrameLayout>

            <!-- Product Title -->
            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingEnd="12dp"
                android:paddingStart="12dp"
                android:text="Product Name"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="Source Sans Pro"
                />

            <!-- Category -->
            <TextView
                android:id="@+id/txtCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingTop="2dp"
                android:text="CATEGORY"
                android:textAllCaps="true"
                android:textColor="#9E9E9E"
                android:textSize="10sp"
                android:fontFamily="Source Sans Pro"
                />

            <!-- Price -->
            <TextView
                android:id="@+id/txtPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:text="Rs 12345"
                android:textColor="#4CAF50"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Favourite Button Only -->
            <ImageButton
                android:id="@+id/btnFavourite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="10dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_heart" />

        </LinearLayout>

        <!-- Add Button (STUCK TO CORNER) -->
        <ImageButton
            android:id="@+id/btnAdd"
            android:layout_width="45dp"
            android:layout_height="50dp"
            android:layout_margin="0dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:background="@android:color/transparent"
            android:scaleType="fitXY"
            android:src="@drawable/featured_shape" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/quantityCard"
            android:layout_width="45dp"
            android:layout_height="100dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:visibility="gone"

            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="#4CAF50">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnMinus"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_minus"
                    app:tint="@android:color/white"/>

                <TextView
                    android:id="@+id/txtQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"/>

                <ImageButton
                    android:id="@+id/btnPlus"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_add"
                    app:tint="@android:color/white"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
