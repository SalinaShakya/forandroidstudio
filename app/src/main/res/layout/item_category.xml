<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/rectangle"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:layout_margin="4dp">

    <!-- 2. INNER ICON BOX: This is the grey/green square container for the icon -->
    <LinearLayout
        android:id="@+id/category_box"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:background="@drawable/grayvector"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="14dp">

        <ImageView
            android:id="@+id/category_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Category Icon"
            android:src="@drawable/esewa"
            app:tint="#00B627" />

    </LinearLayout>

    <!-- 3. TEXT: Now safely kept inside the white container, directly under the icon box -->
    <TextView
        android:id="@+id/category_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:maxLines="1"
        android:text="Electronic Device"
        android:scrollHorizontally="true"

        android:textColor="#4A4A4A"
        android:textSize="11sp" />
</LinearLayout>